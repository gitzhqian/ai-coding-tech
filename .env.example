# ===== Qwen / 阿里云百炼 API 配置 =====
# 申请入口：https://bailian.console.aliyun.com/  ->  API-KEY 管理
# 注意：下面三项缺一不可。utils/ai_client.py 在导入时就会校验
#       QWEN_API_KEY 与 QWEN_BASE_URL，缺失会直接抛出 RuntimeError 导致应用无法启动。

# 你的 API Key，形如 sk-xxxxxxxxxxxxxxxx
QWEN_API_KEY=your_qwen_api_key_here

# 模型服务地址（OpenAI 兼容模式）。大多数账号使用下面的公网默认地址即可；
# 如果你的百炼实例是「业务空间」形式，则需换成控制台给出的专属地址，形如：
#   https://ws-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 要调用的模型 ID。原项目 .env 未提供该项时默认取 qwen-plus，
# 这里显式写出，避免同学照抄 .env.example 后行为与预期不一致。
QWEN_MODEL=qwen-plus

# ===== Flask 应用配置 =====
SECRET_KEY=your_secret_key_here